{
  "name": "Extra Domain Filters",
  "version": "1.0.0",
  "description": "Enhance domain.com.au with extra filters to empower your search.",
  "author": "Niclas Rogulski",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.css\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.css\" --allow-empty-input --fix",
    "check:all": "npm run typecheck && npm run eslint && npm run stylelint",
    "fix:all": "npm run eslint:fix && npm run stylelint:fix"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.0",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.63.0",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
