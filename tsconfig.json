{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["vite/client", "chrome"],
        "paths": {
            "@shared/*": ["./src/shared/*"]
        }
    },
    "exclude": ["dist", "node_modules", ".worktrees"]
}